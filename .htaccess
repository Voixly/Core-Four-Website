DirectoryIndex index.php

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule (^|/)\.env - [F,L]
    RewriteRule ^(?:platform/(?:app|bootstrap|config|database|resources|routes|storage|vendor|tests)|report|tools)(?:/|$) - [F,L]

    RewriteCond %{DOCUMENT_ROOT}/platform/public%{REQUEST_URI} -f
    RewriteRule ^ platform/public%{REQUEST_URI} [L]

    RewriteRule ^ platform/public/index.php [L]
</IfModule>
